# syntax=docker/dockerfile:1
FROM docker.io/library/ubuntu:24.04

LABEL maintainer="Zalos Developers"
LABEL description="Ubuntu 24.04 (Qt 6.4, glibc 2.39) build of Zalos: the oldest supported Qt; builds the .deb and the AppImage"

ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=offscreen

# Drop docs/man/info from installed packages (smaller image) and keep downloaded .debs so the apt cache mount can
# reuse them across builds.
RUN printf 'path-exclude=/usr/share/doc/*\npath-exclude=/usr/share/man/*\npath-exclude=/usr/share/info/*\n' \
      > /etc/dpkg/dpkg.cfg.d/01-nodoc \
    && printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' > /etc/apt/apt.conf.d/01-keep-debs

# One install layer. The apt archives and package lists live on BuildKit cache mounts (persist on the builder, not
# baked into the image), so rebuilds reuse downloads and the image carries no apt cache.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    ca-certificates \
    pkg-config \
    python3 \
    file \
    dpkg-dev \
    curl \
    librsvg2-bin \
    patchelf \
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-declarative-dev \
    qt6-declarative-dev-tools \
    qt6-svg-dev \
    qt6-image-formats-plugins \
    qt6-wayland-dev \
    qt6-websockets-dev \
    qt6-multimedia-dev \
    qt6-shadertools-dev \
    qt6-tools-dev-tools \
    libgl-dev \
    qml6-module-qtquick \
    qml6-module-qtquick-controls \
    qml6-module-qtquick-layouts \
    qml6-module-qtquick-templates \
    qml6-module-qtquick-window \
    qml6-module-qtquick-shapes \
    qml6-module-qtquick-dialogs \
    qml6-module-qtqml-workerscript \
    qml6-module-qtmultimedia \
    qml6-module-qtcore \
    libssl-dev \
    liblzma-dev \
    zlib1g-dev \
    libsqlite3-dev \
    libopenh264-dev \
    xvfb \
    xauth

WORKDIR /workspace

CMD ["/bin/bash"]
