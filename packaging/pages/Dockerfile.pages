# Minified GitHub Pages artifact, baked without any host bind mount (CI-safe, see scripts/minify-pages.sh).
# The readable source of truth stays docs/index.html; /app/out is the deployable site copied out by `docker cp`.
FROM oven/bun:1.4.4-alpine
WORKDIR /app
COPY packaging/pages/package.json ./
RUN bun install --no-save
COPY docs/ ./src/
RUN mkdir -p /app/out \
    && bunx html-minifier-terser \
        --collapse-whitespace \
        --conservative-collapse \
        --remove-comments \
        --remove-redundant-attributes \
        --minify-js true \
        -o /app/out/index.html /app/src/index.html \
    && cp -r /app/src/assets /app/out/assets
