#!/bin/sh
set -e

# AppDir Path Resolution
APPDIR="$(dirname "$(readlink -f "$0")")"
export APPDIR

export PATH="${APPDIR}/usr/bin:${PATH}"

# Only prepend bundled library and plugin paths if they exist
# Qt, QML modules and OpenSSL come from the host. Only a host without libcrypto.so.3 (OpenSSL 4-only, e.g. Fedora
# 45 without openssl3-libs) gets the bundled copy: a host copy is newer, and Qt's TLS plugin and child processes
# (node of the call engine) must keep using it.
if [ -d "${APPDIR}/usr/lib/openssl3-fallback" ] && ! /sbin/ldconfig -p 2>/dev/null | grep -q "libcrypto\.so\.3 "; then
    export LD_LIBRARY_PATH="${APPDIR}/usr/lib/openssl3-fallback${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

if [ -d "${APPDIR}/usr/lib64/qt6/plugins" ]; then
    export QT_PLUGIN_PATH="${APPDIR}/usr/lib64/qt6/plugins:${QT_PLUGIN_PATH}"
fi

# Animated stickers need Qt's WebP image plugin. Use the bundled fallback only when the host Qt has no WebP plugin
# (searching the host plugin dirs), so a host plugin that matches the host Qt is always preferred.
if [ -d "${APPDIR}/usr/lib/webp-fallback/imageformats" ]; then
    _host_webp=""
    for _d in ${QT_PLUGIN_PATH} /usr/lib/qt6/plugins /usr/lib64/qt6/plugins /usr/lib/*/qt6/plugins; do
        [ -f "${_d}/imageformats/libqwebp.so" ] && _host_webp="1" && break
    done
    [ -z "${_host_webp}" ] && export QT_PLUGIN_PATH="${APPDIR}/usr/lib/webp-fallback:${QT_PLUGIN_PATH}"
fi

if [ -d "${APPDIR}/usr/lib64/qt6/qml" ]; then
    export QML2_IMPORT_PATH="${APPDIR}/usr/lib64/qt6/qml:${QML2_IMPORT_PATH}"
    export QML_IMPORT_PATH="${APPDIR}/usr/lib64/qt6/qml:${QML_IMPORT_PATH}"
fi

export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Smart display platform detection (Wayland with xcb fallback vs pure X11)
if [ -z "${QT_QPA_PLATFORM}" ]; then
    if [ -n "${WAYLAND_DISPLAY}" ] || [ "${XDG_SESSION_TYPE}" = "wayland" ]; then
        export QT_QPA_PLATFORM="wayland;xcb"
    elif [ -n "${DISPLAY}" ]; then
        export QT_QPA_PLATFORM="xcb"
    fi
fi

# Input method (IBus / Fcitx) selection is reconciled inside the application (see configureInputMethod in main.cpp).

# Launched from a terminal for normal use: relaunch the AppImage in its own session (setsid) and return the
# prompt, so Ctrl+C or closing the terminal does not reach the app. Debug/test runs, non-terminal launches
# (.desktop) and hosts without setsid run in place. --debug / --test-gui / --screenshot / --help / --version stay
# in the foreground.
case " $* " in
    *" --debug "*|*" --test-gui "*|*" --screenshot "*|*" --help "*|*" --version "*|*" -v "*|*" -h "*) ;;
    *)
        if [ -z "${ZALOS_NO_DETACH}" ] && [ -z "${ZALOS_DEBUG}" ] && [ -n "${APPIMAGE}" ] \
           && command -v setsid >/dev/null 2>&1 && { [ -t 0 ] || [ -t 1 ]; }; then
            ZALOS_NO_DETACH=1 setsid "${APPIMAGE}" "$@" </dev/null >/dev/null 2>&1 &
            exit 0
        fi
        ;;
esac

# Execute Zalos binary
exec "${APPDIR}/usr/bin/zalos" "$@"
